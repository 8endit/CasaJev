  "sum_cents_by_category_935defe7f5_e61f5bc3": {
    "id": "sum_cents_by_category_935defe7f5_e61f5bc3",
    "spec": {
      "description": "Summiert ganzzahlige Cent-Beträge nach exakt unverändertem Kategorienamen.",
      "examples": [
        {
          "input": [
            {
              "amount_cents": 12000,
              "category": "Hardware"
            },
            {
              "amount_cents": 2500,
              "category": "Software"
            },
            {
              "amount_cents": -2000,
              "category": "Hardware"
            },
            {
              "amount_cents": 300,
              "category": "hardware"
            }
          ],
          "output": {
            "Hardware": 10000,
            "Software": 2500,
            "hardware": 300
          }
        },
        {
          "input": [],
          "output": {}
        },
        {
          "input": [
            {
              "amount_cents": -7,
              "category": " A"
            },
            {
              "amount_cents": 4,
              "category": "A"
            },
            {
              "amount_cents": 7,
              "category": " A"
            },
            {
              "amount_cents": -2,
              "category": ""
            }
          ],
          "output": {
            "": -2,
            " A": 0,
            "A": 4
          }
        }
      ],
      "input_kind": "transactions",
      "input_schema": {
        "items": {
          "properties": {
            "amount_cents": {
              "type": "integer"
            },
            "category": {
              "type": "string"
            }
          },
          "required": [
            "category",
            "amount_cents"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "name": "sum_cents_by_category",
      "operation": "sum_by_exact_category",
      "output_kind": "json",
      "output_schema": {
        "additionalProperties": {
          "type": "integer"
        },
        "type": "object"
      },
      "permissions": [
        "compute"
      ],
      "semantics": "main(payload) erhält unverändert eine Liste von Buchungsobjekten. Für jedes Objekt wird amount_cents zum Wert unter dem exakten String category addiert. Kategorienamen werden weder normalisiert noch gekürzt oder in ihrer Groß-/Kleinschreibung verändert. Negative und nullwertige Beträge werden mitgerechnet. Jede vorkommende Kategorie bleibt auch bei Summe null enthalten. Leere Eingabe ergibt {}. Zusätzliche Buchungsfelder werden ignoriert. Verwende ausschließlich reine Python-Datentransformationen mit exakter Ganzzahlarithmetik; gib das Ergebnis als JSON-Objekt zurück."
    },
    "source": "def main(payload):\n    totals = {}\n    for transaction in payload:\n        category = transaction['category']\n        totals[category] = totals.get(category, 0) + transaction['amount_cents']\n    return totals\n",
    "source_hash": "e61f5bc30c837aa555366d57815bca4597be56cfaddbba9ed2f1e426eed28919",
