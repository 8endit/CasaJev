  "csv_exact_duplicate_groups_ad9e20cc6a_22743646": {
    "id": "csv_exact_duplicate_groups_ad9e20cc6a_22743646",
    "spec": {
      "description": "Find exact duplicate full CSV records; preserve case, whitespace and numeric text. Header excluded; one-based record indices.",
      "examples": [
        {
          "input": "name,code\nAda,01\nBob,1\nAda,01\nAda,1\nBob,1\n",
          "output": {
            "extra_duplicates": 2,
            "groups": [
              [
                1,
                3
              ],
              [
                2,
                5
              ]
            ],
            "records": 5
          }
        },
        {
          "input": "name\nAda\nada\n Ada\n",
          "output": {
            "extra_duplicates": 0,
            "groups": [],
            "records": 3
          }
        },
        {
          "input": "a,b\n\"x,y\",\"one\ntwo\"\n\"x,y\",\"one\ntwo\"\n",
          "output": {
            "extra_duplicates": 1,
            "groups": [
              [
                1,
                2
              ]
            ],
            "records": 2
          }
        },
        {
          "input": "",
          "output": {
            "extra_duplicates": 0,
            "groups": [],
            "records": 0
          }
        }
      ],
      "input_kind": "csv",
      "input_schema": {
        "maxLength": 200000,
        "type": "string"
      },
      "name": "csv_exact_duplicate_groups",
      "operation": "group",
      "output_kind": "records",
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "extra_duplicates": {
            "minimum": 0,
            "type": "integer"
          },
          "groups": {
            "items": {
              "items": {
                "minimum": 1,
                "type": "integer"
              },
              "type": "array"
            },
            "type": "array"
          },
          "records": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "groups",
          "records",
          "extra_duplicates"
        ],
        "type": "object"
      },
      "permissions": [
        "compute"
      ],
      "semantics": "Comma separated RFC-style CSV with first row header. Compare complete parsed string records exactly, without normalization. Return all groups of duplicate record indices in first-seen order, one-based excluding header, total record count and extra duplicate count. Reject inconsistent widths."
    },
    "source": "import csv\nimport io\n\ndef main(payload):\n    rows = list(csv.reader(io.StringIO(payload), strict=True))\n    if not rows:\n        return {\"groups\": [], \"records\": 0, \"extra_duplicates\": 0}\n    width = len(rows[0])\n    buckets = {}\n    for index, row in enumerate(rows[1:], 1):\n        if len(row) != width:\n            raise ValueError(\"Inconsistent number of columns\")\n        buckets.setdefault(tuple(row), []).append(index)\n    groups = [indexes for indexes in buckets.values() if len(indexes) > 1]\n    return {\"groups\": groups, \"records\": len(rows) - 1,\n            \"extra_duplicates\": sum(len(group) - 1 for group in groups)}\n",
    "source_hash": "2274364635b9272dfcb47ff3d1de75ecfe0058259fc810f312d378071af9de8d",
