{
  "classification": "known_regression_not_new_holdout",
  "source": "casajev_csv_probe.py HOLDOUT from 2026-09-23; expected outcomes fixed by manual inspection",
  "cases": [
    {
      "id": "quoted_comma",
      "input": "vendor,amount,date\n\"Acme, GmbH\",100,2026-09-03\n",
      "expected": {"kind": "value", "value": {"rows": [{"vendor": "Acme, GmbH", "amount": "100", "date": "2026-09-03"}]}}
    },
    {
      "id": "missing_amount",
      "input": "vendor,amount,date\nAda,,2026-09-04\n",
      "expected": {"kind": "value", "value": {"rows": [{"vendor": "Ada", "amount": null, "date": "2026-09-04"}]}}
    },
    {
      "id": "duplicate_header",
      "input": "vendor,amount,amount\nAda,100,2026-09-05\n",
      "expected": {"kind": "domain_rejection", "rejection_code": "csv_duplicate_header"}
    },
    {
      "id": "ambiguous_date",
      "input": "vendor,amount,date\nAda,100,09/06/2026\n",
      "expected": {"kind": "domain_rejection", "rejection_code": "csv_invalid_date"}
    }
  ]
}
